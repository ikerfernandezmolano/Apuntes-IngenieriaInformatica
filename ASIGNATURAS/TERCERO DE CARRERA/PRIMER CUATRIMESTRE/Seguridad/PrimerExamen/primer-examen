#Instalar apache
sudo apt-get install apache2

#Index
nano /var/www/misite/index.html

#Generar certificado de autofirmado OpenSSL
sudo openssl req -x509 -nodes -days 365 \
    -newkey rsa:2048
    -keyout /etc/ssl/private/misite.key \
    -out /etc/ssl/certs/misite.crt

#HTTP > HTTPS
nano /etc/apache2/sites-available/misite.conf

sudo a2enmod ssl
sudo a2enmod rewrite
sudo a2ensite misite.conf
sudo systemctl restart apache2

